# Security headers, applied by Cloudflare to every response. This file is not served.
# The CSP allows: our own files, Google Fonts, the Make webhook used by the contact form,
# and Cloudflare Web Analytics (only used if it is switched on in the dashboard).
# 'unsafe-inline' in style-src is for the few style="" attributes in the pages; scripts stay strict.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://hook.eu1.make.com https://cloudflareinsights.com; form-action 'self' https://hook.eu1.make.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
